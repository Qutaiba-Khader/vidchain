<?xml version="1.0" encoding="utf-8"?>
<!-- VidChain settings screen (T8.6): the owner's design (design/VidChain Settings.dc.html) in classic Views.
     Row ids are the original app's, so SettingsFragment / SettingsOnClickLogic keep their click logic. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/container_main_layout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/vc_settings_bg"
	android:theme="@style/VcSettings.Overlay"
	android:fillViewport="true"
	android:scrollbars="none"
	tools:ignore="ContentDescription,TooManyViews">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingBottom="16dp">

		<TextView
			android:layout_width="match_parent"
			android:layout_height="56dp"
			android:fontFamily="@font/font_family_medium"
			android:gravity="center_vertical"
			android:paddingStart="20dp"
			android:paddingEnd="20dp"
			android:text="@string/vc_settings_title"
			android:textColor="@color/vc_settings_text"
			android:textSize="22sp" />


		<TextView style="@style/VcSettings.Section" android:text="@string/vc_settings_section_appearance" />

		<LinearLayout style="@style/VcSettings.Card">

			<LinearLayout android:id="@+id/btn_dark_mode_ui" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_dark_mode" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_dark_mode_ui" style="@style/VcSettings.RowTitle" android:text="@string/title_enable_dark_mode" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_dark" />
				</LinearLayout>
				<androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_dark_mode_ui" style="@style/VcSettings.Switch" />
			</LinearLayout>
			<View style="@style/VcSettings.Divider" />

			<LinearLayout android:id="@+id/btn_language_picker" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_language" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_language_picker" style="@style/VcSettings.RowTitle" android:text="@string/title_application_language" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_language" />
				</LinearLayout>
				<ImageView style="@style/VcSettings.Chevron" />
			</LinearLayout>
			<View style="@style/VcSettings.Divider" />

			<LinearLayout android:id="@+id/btn_content_location" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_content" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_content_location" style="@style/VcSettings.RowTitle" android:text="@string/title_preferred_content_region" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_region" />
				</LinearLayout>
				<ImageView style="@style/VcSettings.Chevron" />
			</LinearLayout>
		</LinearLayout>

		<TextView style="@style/VcSettings.Section" android:text="@string/vc_settings_section_downloads" />

		<LinearLayout style="@style/VcSettings.Card">

			<LinearLayout android:id="@+id/btn_default_download_location" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_folder" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_default_download_location" style="@style/VcSettings.RowTitle" android:text="@string/title_download_location" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_location" />
				</LinearLayout>
				<ImageView style="@style/VcSettings.Chevron" />
			</LinearLayout>
			<View style="@style/VcSettings.Divider" />

			<LinearLayout android:id="@+id/btn_wifi_only_downloads" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_wifi_signal" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_wifi_only_downloads" style="@style/VcSettings.RowTitle" android:text="@string/title_wifi_only_download" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_wifi" />
				</LinearLayout>
				<androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_wifi_only_downloads" style="@style/VcSettings.Switch" />
			</LinearLayout>
			<View style="@style/VcSettings.Divider" />

			<LinearLayout android:id="@+id/btn_hide_task_notifications" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_notifications" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_hide_task_notifications" style="@style/VcSettings.RowTitle" android:text="@string/title_hide_task_notifications" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_hide_notif" />
				</LinearLayout>
				<androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_hide_task_notifications" style="@style/VcSettings.Switch" />
			</LinearLayout>
			<View style="@style/VcSettings.Divider" />

			<LinearLayout android:id="@+id/btn_play_notification_sound" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_audio" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_play_notification_sound" style="@style/VcSettings.RowTitle" android:text="@string/title_play_notification_sound" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_sound" />
				</LinearLayout>
				<androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_play_notification_sound" style="@style/VcSettings.Switch" />
			</LinearLayout>
			<View style="@style/VcSettings.Divider" />

			<LinearLayout android:id="@+id/btn_single_click_open" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_single_click" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_single_click_open" style="@style/VcSettings.RowTitle" android:text="@string/title_single_click_open" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_single_click" />
				</LinearLayout>
				<androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_single_click_open" style="@style/VcSettings.Switch" />
			</LinearLayout>
		</LinearLayout>

		<TextView style="@style/VcSettings.Section" android:text="@string/vc_settings_section_browser" />

		<LinearLayout style="@style/VcSettings.Card">

			<LinearLayout android:id="@+id/btn_browser_homepage" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_document_big" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_browser_homepage" style="@style/VcSettings.RowTitle" android:text="@string/title_browser_homepage" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_homepage" />
				</LinearLayout>
				<ImageView style="@style/VcSettings.Chevron" />
			</LinearLayout>
			<View style="@style/VcSettings.Divider" />

			<LinearLayout android:id="@+id/btn_enable_popup_blocker" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_popup_block" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_enable_popup_blocker" style="@style/VcSettings.RowTitle" android:text="@string/title_block_popup_ads" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_popups" />
				</LinearLayout>
				<androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_enable_popup_blocker" style="@style/VcSettings.Switch" />
			</LinearLayout>
			<View style="@style/VcSettings.Divider" />

			<LinearLayout android:id="@+id/btn_show_image_on_web" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_images" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_show_image_on_web" style="@style/VcSettings.RowTitle" android:text="@string/title_show_image_on_webpage" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_images" />
				</LinearLayout>
				<androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_show_image_on_web" style="@style/VcSettings.Switch" />
			</LinearLayout>
			<View style="@style/VcSettings.Divider" />

			<LinearLayout android:id="@+id/btn_enable_video_grabber" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_video" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_enable_video_grabber" style="@style/VcSettings.RowTitle" android:text="@string/title_show_video_grabber" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_grabber" />
				</LinearLayout>
				<androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_enable_video_grabber" style="@style/VcSettings.Switch" />
			</LinearLayout>
		</LinearLayout>

		<TextView style="@style/VcSettings.Section" android:text="@string/vc_settings_section_vidchain" />

		<LinearLayout style="@style/VcSettings.Card">

			<LinearLayout android:id="@+id/btn_vidchain_fallbacks" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_settings" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_vidchain_fallbacks" style="@style/VcSettings.RowTitle" android:text="@string/vc_settings_vidchain" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_vidchain" />
				</LinearLayout>
				<ImageView style="@style/VcSettings.Chevron" />
			</LinearLayout>
		</LinearLayout>

		<TextView style="@style/VcSettings.Section" android:text="@string/vc_settings_section_support" />

		<LinearLayout style="@style/VcSettings.Card">

			<LinearLayout android:id="@+id/btn_open_feedback" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_feedback" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_open_feedback" style="@style/VcSettings.RowTitle" android:text="@string/title_your_send_feedback" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_feedback" />
				</LinearLayout>
				<ImageView style="@style/VcSettings.Chevron" />
			</LinearLayout>
			<View style="@style/VcSettings.Divider" />

			<LinearLayout android:id="@+id/btn_share_with_friends" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_share" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_share_with_friends" style="@style/VcSettings.RowTitle" android:text="@string/title_share_with_friends" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_share" />
				</LinearLayout>
				<ImageView style="@style/VcSettings.Chevron" />
			</LinearLayout>
			<View style="@style/VcSettings.Divider" />

			<LinearLayout android:id="@+id/btn_open_about_info" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_information" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_open_about_info" style="@style/VcSettings.RowTitle" android:text="@string/title_open_application_info" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_app_info" />
				</LinearLayout>
				<ImageView style="@style/VcSettings.Chevron" />
			</LinearLayout>
			<View style="@style/VcSettings.Divider" />

			<LinearLayout android:id="@+id/btn_open_privacy_policy" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_privacy_policy" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_open_privacy_policy" style="@style/VcSettings.RowTitle" android:text="@string/title_privacy_policy" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_privacy" />
				</LinearLayout>
				<ImageView style="@style/VcSettings.Chevron" />
			</LinearLayout>
			<View style="@style/VcSettings.Divider" />

			<LinearLayout android:id="@+id/btn_open_terms_condition" style="@style/VcSettings.Row">
				<ImageView style="@style/VcSettings.Icon" android:src="@drawable/ic_button_term_conditions" />
				<LinearLayout style="@style/VcSettings.Texts">
					<TextView android:id="@+id/txt_open_terms_condition" style="@style/VcSettings.RowTitle" android:text="@string/title_terms_conditions" />
					<TextView style="@style/VcSettings.RowDesc" android:text="@string/vc_settings_desc_terms" />
				</LinearLayout>
				<ImageView style="@style/VcSettings.Chevron" />
			</LinearLayout>
		</LinearLayout>

		<LinearLayout
			style="@style/VcSettings.Card"
			android:layout_marginTop="16dp"
			android:padding="16dp">

			<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
				<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
					android:fontFamily="@font/font_family_regular" android:text="@string/title_version_number"
					android:textColor="@color/vc_settings_text2" android:textSize="14sp" />
				<TextView android:id="@+id/txt_version_number_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
					android:fontFamily="@font/font_family_regular" android:textColor="@color/vc_settings_text" android:textSize="14sp" />
			</LinearLayout>

			<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
				<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
					android:fontFamily="@font/font_family_regular" android:text="@string/title_build_version"
					android:textColor="@color/vc_settings_text2" android:textSize="14sp" />
				<TextView android:id="@+id/txt_build_version_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
					android:fontFamily="@font/font_family_regular" android:textColor="@color/vc_settings_text" android:textSize="14sp" />
			</LinearLayout>

			<View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/vc_settings_divider" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:fontFamily="@font/font_family_regular"
				android:lineSpacingExtra="3sp"
				android:text="@string/text_restart_if_somethings_off"
				android:textColor="@color/vc_settings_text2"
				android:textSize="13sp" />

			<TextView
				android:id="@+id/btn_restart_application"
				android:layout_width="match_parent"
				android:layout_height="40dp"
				android:layout_marginTop="12dp"
				android:background="@drawable/vc_settings_outline_button"
				android:clickable="true"
				android:focusable="true"
				android:fontFamily="@font/font_family_medium"
				android:gravity="center"
				android:text="@string/title_restart_application"
				android:textColor="@color/color_secondary"
				android:textSize="14sp" />
		</LinearLayout>

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			android:fontFamily="@font/font_family_regular"
			android:gravity="center"
			android:lineSpacingExtra="5sp"
			android:paddingStart="32dp"
			android:paddingEnd="32dp"
			android:text="@string/text_special_support_thank_you"
			android:textColor="@color/vc_settings_text3"
			android:textSize="12sp" />

		<LinearLayout
			android:id="@+id/btn_follow_shibafoss"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="2dp"
			android:background="@drawable/vc_settings_row_bg"
			android:clickable="true"
			android:focusable="true"
			android:minHeight="32dp"
			android:gravity="center"
			android:orientation="horizontal"
			android:paddingStart="12dp"
			android:paddingEnd="12dp">

			<TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
				android:fontFamily="@font/font_family_regular" android:text="@string/vc_settings_follow"
				android:textColor="@color/vc_settings_text2" android:textSize="12sp" />

			<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
				android:fontFamily="@font/font_family_regular" android:text="@string/vc_settings_follow_handle"
				android:textColor="@color/color_secondary" android:textSize="12sp" />
		</LinearLayout>
	</LinearLayout>
</ScrollView>
