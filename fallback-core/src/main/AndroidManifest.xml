<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<!-- T7.2: ask Android directly to exempt this app from battery optimization (once) -->
	<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

	<application>
		<!-- Settings -> VidChain fallbacks (T1.10) -->
		<activity
			android:name="org.websnake.vidchain.fallback.ui.VidChainSettingsActivity"
			android:exported="false"
			android:label="@string/vidchain_settings_title"
			android:theme="@style/Theme.VidChain" />

		<!-- Settings -> VidChain fallbacks -> Open-source licences (T6.3) -->
		<activity
			android:name="org.websnake.vidchain.fallback.ui.VidChainLicencesActivity"
			android:exported="false"
			android:label="@string/vidchain_licences_title"
			android:theme="@style/Theme.VidChain" />

		<!-- T9 stage 4c: the site x method test matrix runs one method on one link from `adb shell` only (DUMP is held by
		     the shell and the system, never by an app) -->
		<receiver
			android:name="org.websnake.vidchain.fallback.ui.MatrixReceiver"
			android:exported="true"
			android:permission="android.permission.DUMP">
			<intent-filter>
				<action android:name="org.websnake.vidchain.MATRIX" />
			</intent-filter>
		</receiver>

		<!-- shares the trace log file (cache/vidchain-share only) -->
		<provider
			android:name="org.websnake.vidchain.fallback.ui.VidChainFileProvider"
			android:authorities="${applicationId}.vidchain.files"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/vidchain_file_paths" />
		</provider>
	</application>
</manifest>
