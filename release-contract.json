{
  "_note": "Release contract (T0.6). release.yml publishes `release.version` once: when CI is green on main and the tag v<version> does not exist yet, and only if app/build.gradle carries the same versionName/versionCode. null = nothing to release. Asset names stay version-free so README links to releases/latest work; the tag carries the version. `fully_tested: false` adds the 'not fully tested yet' line to the notes (INBOX #3: intermediate releases before the one full test pass).",
  "release": {
    "version": "0.5.0",
    "version_code": 500,
    "fully_tested": false
  },
  "package": "org.websnake.vidchain",
  "assets": {
    "arm64-v8a": "vidchain-arm64-v8a.apk",
    "armeabi-v7a": "vidchain-armeabi-v7a.apk",
    "x86": "vidchain-x86.apk",
    "x86_64": "vidchain-x86_64.apk",
    "universal": "vidchain-universal.apk"
  },
  "obtainium": {
    "autoApkFilterByArch": true,
    "includePrereleases": false,
    "sortMethodChoice": "date"
  },
  "keep_releases": 10,
  "methods_per_abi": {
    "_note": "Fallback methods per ABI (Q8 = A: new natives on 64-bit only). CI and release.yml check every APK against this with tools/release/method_matrix.py; the universal APK carries each ABI's set.",
